{
  "redirects": [
    { "source": "/", "destination": "/team", "permanent": false },
    { "source": "/apple-touch-icon.png", "destination": "/logo.svg", "permanent": false }
  ],
  "rewrites": [
    { "source": "/start", "destination": "/start.html" },
    { "source": "/team/:team", "destination": "/api/team-reminders-page?team=:team" },
    { "source": "/team/:team/", "destination": "/api/team-reminders-page?team=:team" },
    { "source": "/captain/:team", "destination": "/api/captain-field-page?team=:team" },
    { "source": "/captain/:team/", "destination": "/api/captain-field-page?team=:team" },
    { "source": "/calendar/:team.ics", "destination": "/api/calendar?team=:team" },
    { "source": "/team", "destination": "/api/team-reminders-page" },
    { "source": "/team/", "destination": "/api/team-reminders-page" },
    { "source": "/captain", "destination": "/api/captain-field-page" },
    { "source": "/captain/", "destination": "/api/captain-field-page" },
    { "source": "/calendar.ics", "destination": "/api/calendar" }
  ],
  "crons": [
    { "path": "/api/team-state", "schedule": "0 22 * * 4" },
    { "path": "/api/team-state", "schedule": "0 23 * * 4" }
  ]
}
