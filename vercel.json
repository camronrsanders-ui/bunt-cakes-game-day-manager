{
  "redirects": [
    {
      "source": "/",
      "destination": "/start",
      "permanent": false
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/feildhaus-mark.svg",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/start",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/api/team-state/umpire",
      "destination": "/api/account?mode=umpire"
    },
    {
      "source": "/team/:team",
      "destination": "/api/team-reminders-page?team=:team"
    },
    {
      "source": "/team/:team/",
      "destination": "/api/team-reminders-page?team=:team"
    },
    {
      "source": "/captain/:team",
      "destination": "/api/captain-field-page?team=:team"
    },
    {
      "source": "/captain/:team/",
      "destination": "/api/captain-field-page?team=:team"
    },
    {
      "source": "/calendar/:team.ics",
      "destination": "/api/calendar?team=:team"
    },
    {
      "source": "/team",
      "destination": "/api/team-reminders-page"
    },
    {
      "source": "/team/",
      "destination": "/api/team-reminders-page"
    },
    {
      "source": "/captain",
      "destination": "/api/captain-field-page"
    },
    {
      "source": "/captain/",
      "destination": "/api/captain-field-page"
    },
    {
      "source": "/calendar.ics",
      "destination": "/api/calendar"
    }
  ],
  "crons": [
    {
      "path": "/api/team-state",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/team-state",
      "schedule": "0 23 * * *"
    }
  ]
}